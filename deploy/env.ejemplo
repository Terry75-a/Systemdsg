#--------------------------------------------------------------------
# .env de PRODUCCIÓN (cPanel)
# Copia este archivo como  .env  en la carpeta del sistema (junto a
# spark) y llena los datos de TU hosting. Nunca subas el .env a git.
#--------------------------------------------------------------------
CI_ENVIRONMENT = production

# URL pública, con https y terminada en /
app.baseURL = 'https://tudominio.com/'
app.forceGlobalSecureRequests = true
# Direcciones limpias (sin /index.php/): Apache usa public/.htaccess
app.indexPage = ''

# Base creada en cPanel → Bases de datos MySQL
database.default.hostname = localhost
database.default.database = usuario_sistemapo
database.default.username = usuario_dbuser
database.default.password = 'contraseña-de-la-base'
database.default.DBDriver = MySQLi
database.default.DBPrefix =

# Texto largo y secreto para la URL de cron /cron/faltas?token=...
CRON_TOKEN = cambia-esto-por-un-texto-largo-y-secreto

# Notificaciones push de Asisten (copia los valores de tu .env local)
VAPID_PUBLIC_KEY =
VAPID_PRIVATE_KEY_B64 =
VAPID_SUBJECT = mailto:soporte@tudominio.com

# Correo de avisos de vencimiento y formularios (cPanel → Cuentas de correo)
SMTP_HOST = mail.tudominio.com
SMTP_PORT = 465
SMTP_ENCRYPTION = ssl
SMTP_USERNAME = avisos@tudominio.com
SMTP_PASSWORD =
SMTP_FROM_EMAIL = avisos@tudominio.com
SMTP_FROM_NAME = "DSG Peru"
SMTP_TO_EMAIL = avisos@tudominio.com
SMTP_TO_NAME = "DSG Peru"

# WhatsApp de avisos (servidor Node aparte; dejar vacío si no se usa)
WHATSAPP_API_URL =
WHATSAPP_TOKEN =
WHATSAPP_ADMIN_PHONE =

# Las tablas de Asisten se crean/actualizan solas al abrir el sistema.
# asisten.autoMigrate = false   ← para apagarlo

/* ======== SECCIÓN SERVICIOS ======== */
.servicios-dsg {
  background: linear-gradient(180deg, #f9fafb 0%, #f2f2f2 100%);
  padding: 100px 20px;
}

.servicios-header {
  text-align: center;
  margin-bottom: 60px;
}

.servicios-header h1 {
  font-size: 2.5rem;
  font-weight: 800;
  color: #111;
}

.servicios-header h1 span {
  color: #00c896;
}

.servicios-header p {
  color: #555;
  font-size: 1.1rem;
  margin-top: 10px;
}

/* ======== GRID ======== */
.servicios-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: 35px;
  max-width: 1150px;
  margin: 0 auto;
}

/* ======== TARJETAS ======== */
.servicio-card {
  background: rgba(255, 255, 255, 0.85);
  border-radius: 20px;
  padding: 35px 25px;
  text-align: center;
  box-shadow: 0 8px 25px rgba(0, 0, 0, 0.08);
  transition: all 0.3s ease;
  backdrop-filter: blur(10px);
  border: 1px solid rgba(255, 255, 255, 0.5);
}

.servicio-card:hover {
  transform: translateY(-10px);
  box-shadow: 0 15px 35px rgba(0, 0, 0, 0.12);
}

/* ======== ICONOS ======== */
.servicio-icon {
  background: linear-gradient(135deg, #00c896, #007e6b);
  color: #fff;
  font-size: 2rem;
  width: 70px;
  height: 70px;
  border-radius: 50%;
  margin: 0 auto 20px;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6px 15px rgba(0, 200, 150, 0.3);
}

.servicio-card h3 {
  font-size: 1.3rem;
  font-weight: 700;
  color: #007e6b;
  margin-bottom: 10px;
}

.servicio-card p {
  color: #555;
  font-size: 0.95rem;
  line-height: 1.6;
  margin-bottom: 25px;
}

/* ======== BOTONES ======== */
.btn-outline,
.btn-primary {
  display: inline-block;
  padding: 10px 22px;
  border-radius: 8px;
  font-weight: 600;
  text-decoration: none;
  transition: 0.3s;
}

.btn-outline {
  border: 2px solid #00c896;
  color: #00c896;
}

.btn-outline:hover {
  background: #00c896;
  color: #fff;
}

.btn-primary {
  background: linear-gradient(135deg, #00c896, #007e6b);
  color: #fff;
  border: none;
}

.btn-primary:hover {
  background: linear-gradient(135deg, #00b685, #006e5d);
}

/* ======== DESTACADO ======== */
.destacado {
  background: linear-gradient(135deg, #00c896, #007e6b);
  color: #fff;
  transform: scale(1.05);
}

.destacado h3 {
  color: #fff;
}

.destacado .btn-primary {
  background: #fff;
  color: #007e6b;
}

.destacado .btn-primary:hover {
  background: #f1f1f1;
}

/* ======== RESPONSIVE ======== */
/* ======== RESPONSIVE MEJORADO PARA MÓVILES ======== */
@media (max-width: 768px) {

  /* Sección general */
  .servicios-dsg {
    padding: 60px 15px;
    background: linear-gradient(180deg, #f9fafb 0%, #f1f1f1 100%);
  }

  /* Título */
  .servicios-header h1 {
    font-size: 1.8rem;
    margin-bottom: 10px;
  }

  .servicios-header p {
    font-size: 0.95rem;
    line-height: 1.5;
    margin-bottom: 35px;
  }

  /* Grid: cambia a una sola columna */
  .servicios-grid {
    grid-template-columns: 1fr;
    gap: 25px;
  }

  /* Tarjeta */
  .servicio-card {
    padding: 25px 20px;
    border-radius: 16px;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.08);
  }

  /* Ícono */
  .servicio-icon {
    width: 55px;
    height: 55px;
    font-size: 1.5rem;
    margin-bottom: 15px;
  }

  /* Título de servicio */
  .servicio-card h3 {
    font-size: 1.1rem;
    margin-bottom: 8px;
  }

  /* Texto */
  .servicio-card p {
    font-size: 0.9rem;
    line-height: 1.5;
    margin-bottom: 20px;
  }

  /* Botones */
  .btn-outline,
  .btn-primary {
    width: 100%;
    font-size: 0.95rem;
    padding: 10px 0;
  }

  /* Servicio destacado */
  .destacado {
    transform: none;
    background: linear-gradient(135deg, #00c896, #007e6b);
    color: #fff;
  }

  .destacado .btn-primary {
    background: #fff;
    color: #007e6b;
    font-weight: 600;
  }

  /* Animación más suave */
  .servicio-card {
    opacity: 0;
    transform: translateY(20px);
    animation: fadeInMobile 0.6s ease forwards;
  }

  @keyframes fadeInMobile {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
}


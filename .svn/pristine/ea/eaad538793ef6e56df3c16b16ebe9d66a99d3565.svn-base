/* === Fondo general === */
body {
  margin: 0;
  padding: 0;
  height: 100vh;
  display: flex;
  justify-content: center;
  align-items: center;
  
  
  color: #020303;
}

/* === Contenedor principal === */
.login-container {
  display: flex;
  justify-content: center;
  align-items: center;
  width: 100%;
}

/* === Tarjeta de login === */
.login-card {
  background: rgba(94, 94, 94, 0.264);
  backdrop-filter: blur(12px);
  border: 1px solid rgba(255, 255, 255, 0.15);
  border-radius: 18px;
  padding: 40px;
  width: 340px;
  text-align: center;
  box-shadow: 0 8px 30px rgba(0, 0, 0, 0.3);
  animation: fadeIn 1s ease-in-out;
}

/* === Título === */
.title {
  font-size: 1.7rem;
  margin-bottom: 25px;
  font-family: 'Itim', cursive;
}

.title span {
  color: #38bdf8;
}

/* === Campos del formulario === */
.form-group {
  text-align: left;
  margin-bottom: 20px;
  
}

label {
  display: block;
  margin-bottom: 6px;
  font-weight: 500;
  font-family: 'Itim', cursive;
}

input {
  width: 100%;
  padding: 10px 14px;
  border-radius: 10px;
  border: none;
  outline: none;
  font-size: 1rem;
  color: #0f172a;
  background-color: #f8fafc;
  font-family: 'Itim', cursive;
  transition: box-shadow 0.3s;
}



/* === Ícono del ojo === */
.input-wrapper {
  position: relative;
}

.input-wrapper i {
  position: absolute;
  right: 12px;
  top: 50%;
  transform: translateY(-50%);
  color: #475569;
  cursor: pointer;
  transition: color 0.2s;
}



/* === Botones === */
.btn-group {
  display: flex;
  justify-content: space-between;
  margin-top: 25px;
}

.btn {
  width: 48%;
  padding: 10px 0;
  border: none;
  border-radius: 10px;
  text-decoration: none;
  font-weight: 600;
  font-size: 0.95rem;
  cursor: pointer;
  transition: all 0.3s ease;
  font-family: 'Itim', cursive;
}

.volver {
  background-color: #000000e7;
  color: #f8fafc;
}

.volver:hover {
  background-color: #475569;
}

.acceder {
  background-color: rgb(0, 255, 136);
  color: rgb(0, 0, 0);
}



/* === Animación === */
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(-10px); }
  to { opacity: 1; transform: translateY(0); }
}

/* === Responsive === */
@media (max-width: 400px) {
  .login-card {
    width: 90%;
    padding: 30px;
  }
}


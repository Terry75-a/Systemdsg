        box-shadow: 0 0 0 0.25rem rgba(93, 135, 255, 0.1);
    }
</style>

<script>
document.addEventListener("DOMContentLoaded", function () {
    // Función genérica para cargar Ubigeo
    function setupUbigeo(deptId, provId, distId) {
        fetch("<?= base_url('ubigeo/departamentos') ?>")
            .then(res => res.json())
            .then(data => {
                let deptSelect = document.getElementById(deptId);
                data.forEach(d => {
                    deptSelect.innerHTML += `<option value="${d.id}">${d.name}</option>`;
                });
            });

        document.getElementById(deptId).addEventListener("change", function(){
            fetch("<?= base_url('ubigeo/provincias') ?>/" + this.value)
                .then(res => res.json())
                .then(data => {
                    let provSelect = document.getElementById(provId);
                    provSelect.innerHTML = `<option selected disabled>Seleccionar</option>`;
                    data.forEach(p => {
                        provSelect.innerHTML += `<option value="${p.id}">${p.name}</option>`;
                    });
                    document.getElementById(distId).innerHTML = `<option selected disabled>Seleccionar</option>`;
                });
        });

        document.getElementById(provId).addEventListener("change", function(){
            fetch("<?= base_url('ubigeo/distritos') ?>/" + this.value)
                .then(res => res.json())
                .then(data => {
                    let distSelect = document.getElementById(distId);
                    distSelect.innerHTML = `<option selected disabled>Seleccionar</option>`;
                    data.forEach(d => {
                        distSelect.innerHTML += `<option value="${d.id}">${d.name}</option>`;
                    });
                });
        });
    }

    // Inicializar Ubigeo para ambas pestañas
    setupUbigeo("departamento", "provincia", "distrito");
    setupUbigeo("departamento_rep", "provincia_rep", "distrito_rep");

    
    const btnBuscarDni = document.getElementById('btnBuscarDni');
    btnBuscarDni.addEventListener('click', function () {
        const dni = document.getElementById('dni').value.trim();
        if (dni.length !== 8) { alert("DNI debe tener 8 dígitos"); return; }
        
        btnBuscarDni.disabled = true;
        fetch('<?= base_url("clientes/buscar-dni") ?>', {
            method: 'POST',
            headers: { "Content-Type": "application/x-www-form-urlencoded" },
            body: "dni=" + encodeURIComponent(dni)
        })
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                document.getElementById('nombre').value = data.nombres;
                document.getElementById('apellido_materno').value = data.apellido_materno;
                document.getElementById('apellido_paterno').value = data.apellido_paterno;
            } else {
                alert(data.message || "No encontrado");
            }
        })
        .finally(() => btnBuscarDni.disabled = false);
    });

    // Búsqueda RUC
    const btnBuscarRuc = document.getElementById('btnBuscarRuc');
    btnBuscarRuc.addEventListener('click', function () {
        const ruc = document.getElementById('ruc').value.trim();
        if (ruc.length !== 11) { alert("RUC debe tener 11 dígitos"); return; }

        btnBuscarRuc.disabled = true;
        fetch('<?= base_url("clientes/buscar-ruc") ?>', {
            method: 'POST',
            headers: { "Content-Type": "application/x-www-form-urlencoded" },
            body: "ruc=" + encodeURIComponent(ruc)
        })
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                document.getElementById('razon_social').value = data.razon;
                document.getElementById('direccion').value = data.direccion;
            } else {
                alert(data.message || "No encontrado");
            }
        })
        .finally(() => btnBuscarRuc.disabled = false);
    });
});
</script>

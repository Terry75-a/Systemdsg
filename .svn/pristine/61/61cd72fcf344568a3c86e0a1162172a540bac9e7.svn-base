<script>
// ── TOKEN CSRF (necesario para todos los POST en CI4)
const csrfName  = '<?= csrf_token() ?>';
const csrfHash  = '<?= csrf_hash() ?>';

// ── BASE URL del proyecto
const BASE_URL  = '<?= base_url() ?>';
const PROVINCIA_EDITAR = "<?= $persona ? $persona->id_provincia : '' ?>";
const DISTRITO_EDITAR  = "<?= $persona ? $persona->id_distrito : '' ?>";

const PROVINCIA_EDITARd = "<?= $empresa ? $empresa->id_provincia : '' ?>";
const DISTRITO_EDITARX = "<?=  $empresa ? $empresa->id_distrito : '' ?>";


// ════════════════════════════════════════════════════
// BÚSQUEDA POR DNI
// El controlador devuelve: { success, nombres, apellido_paterno, apellido_materno }
// Ruta: POST /personas/buscar-dni
// ════════════════════════════════════════════════════
document.getElementById('btnBuscarDni').addEventListener('click', async function () {

    const dni = document.getElementById('dni').value.trim();
    const alerta = document.getElementById('alertaDni');

    // Limpiar alerta anterior
    alerta.innerHTML = '';

    // Validar que el DNI tenga exactamente 8 dígitos
    if (!/^\d{8}$/.test(dni)) {
        alerta.innerHTML = `<small class="text-danger">
            <i class="fa-solid fa-triangle-exclamation"></i>
            El DNI debe tener exactamente 8 dígitos numéricos.
        </small>`;
        return;
    }

    // Mostrar spinner, ocultar ícono
    document.getElementById('spinnerDni').classList.remove('d-none');
    document.getElementById('iconoDni').classList.add('d-none');
    this.disabled = true;

    try {
        const formData = new FormData();
        formData.append('dni', dni);
        formData.append(csrfName, csrfHash); // token CSRF obligatorio en CI4

        // POST a la ruta definida en Routes.php
        const response = await fetch(`${BASE_URL}personas/buscar-dni`, {
            method: 'POST',
            body: formData
        });

        const data = await response.json();

        if (data.success) {
            // ✅ Llenar los campos automáticamente con los datos del API
            document.getElementById('nombre').value           = data.nombres          ?? '';
            document.getElementById('apellido_paterno').value = data.apellido_paterno ?? '';
            document.getElementById('apellido_materno').value = data.apellido_materno ?? '';

            // Mostrar mensaje de éxito
            alerta.innerHTML = `<small class="text-success">
                <i class="fa-solid fa-circle-check"></i>
                Datos encontrados correctamente.
            </small>`;

            // Enfocar el campo teléfono para que el usuario continúe llenando
            document.getElementById('telefono').focus();

        } else {
            document.getElementById('nombre').value = '';
            document.getElementById('apellido_paterno').value = '';
            document.getElementById('apellido_materno').value = '';

            // Si el controlador envió la bandera 'registrado', usamos un estilo más llamativo
            if (data.registrado) {
                alerta.innerHTML = `<div class="alert alert-warning py-1 px-2 mt-2" style="font-size: 0.85rem;">
                     ${data.message}
                </div>`;
            } else {
                alerta.innerHTML = `<small class="text-danger">
                    <i class="fa-solid fa-circle-xmark"></i> ${data.message ?? 'DNI no encontrado.'}
                </small>`;
            }
            
        }

    } catch (error) {
        console.error('Error en búsqueda DNI:', error);
        alerta.innerHTML = `<small class="text-danger">
            <i class="fa-solid fa-circle-xmark"></i>
            Error de conexión. Intenta nuevamente.
        </small>`;
    } finally {
        // Ocultar spinner, mostrar ícono, habilitar botón
        document.getElementById('spinnerDni').classList.add('d-none');
        document.getElementById('iconoDni').classList.remove('d-none');
        this.disabled = false;
    }
});
    

// También buscar al presionar Enter en el campo DNI
document.getElementById('dni').addEventListener('keydown', function (e) {
    if (e.key === 'Enter') {
        e.preventDefault(); // evitar submit del form
        document.getElementById('btnBuscarDni').click();
    }
});

// ════════════════════════════════════════════════════
// BÚSQUEDA POR RUC
// El controlador devuelve: { success, razon, direccion }
// Ruta: POST /personas/buscar-ruc
// ════════════════════════════════════════════════════
document.getElementById('btnBuscarRuc').addEventListener('click', async function () {

    const ruc    = document.getElementById('ruc').value.trim();
    const alerta = document.getElementById('alertaRuc');

    alerta.innerHTML = '';

    // Validar que el RUC tenga 11 dígitos
    if (!/^\d{11}$/.test(ruc)) {
        alerta.innerHTML = `<small class="text-danger">
            <i class="fa-solid fa-triangle-exclamation"></i>
            El RUC debe tener exactamente 11 dígitos numéricos.
        </small>`;
        return;
    }

    document.getElementById('spinnerRuc').classList.remove('d-none');
    document.getElementById('iconoRuc').classList.add('d-none');
    this.disabled = true;

    try {
        const formData = new FormData();
        formData.append('ruc', ruc);
        formData.append(csrfName, csrfHash);

        const response = await fetch(`${BASE_URL}personas/buscar-ruc`, {
            method: 'POST',
            body: formData
        });

        const data = await response.json();

        if (data.success) {
            document.getElementById('razon_social').value    = data.razon    ?? '';
            document.getElementById('direccion').value = data.direccion ?? '';

            alerta.innerHTML = `<small class="text-success">
                <i class="fa-solid fa-circle-check"></i>
                Empresa encontrada correctamente.
            </small>`;

        } else {
            document.getElementById('razon_social').value    = '';
            document.getElementById('direccion').value = '';

            if(data.registrado){
                alerta.innerHTML= `<div class="alert alert-warning py-1 px-2 mt-2" style="font-size: 0.85rem;">
                     ${data.message}
                </div>`;
            }

            alerta.innerHTML = `<small class="text-danger">
                <i class="fa-solid fa-circle-xmark"></i>
                ${data.message ?? 'RUC no encontrado o error en el servicio.'}
            </small>`;
        }

    } catch (error) {
        alerta.innerHTML = `<small class="text-danger">
            <i class="fa-solid fa-circle-xmark"></i>
            Error de conexión. Intenta nuevamente.
        </small>`;
        console.error('Error en búsqueda RUC:', error);

    } finally {
        document.getElementById('spinnerRuc').classList.add('d-none');
        document.getElementById('iconoRuc').classList.remove('d-none');
        this.disabled = false;
    }
});

// También buscar al presionar Enter en el campo RUC
document.getElementById('ruc').addEventListener('keydown', function (e) {
    if (e.key === 'Enter') {
        e.preventDefault();
        document.getElementById('btnBuscarRuc').click();
    }
});

// ════════════════════════════════════════════════════
// UBIGEO EN CASCADA (Departamento → Provincia → Distrito)
// Ruta: GET /ubigeo/provincias/{id_dep}
// Ruta: GET /ubigeo/distritos/{id_prov}
// ════════════════════════════════════════════════════

// --- Función para cargar Provincias ---
async function cargarProvincias(idDep, idProvSelected = null) {
    const selectProv = document.getElementById('provincia_rep');
    const selectDist = document.getElementById('distrito_rep');

    if (!idDep) {
        selectProv.innerHTML = '<option value="">-- Seleccionar --</option>';
        selectDist.innerHTML = '<option value="">-- Seleccionar --</option>';
        return;
    }

    try {
        const res = await fetch(`${BASE_URL}ubigeo/provincias/${idDep}`);
        const data = await res.json();

        selectProv.innerHTML = '<option value="">-- Seleccionar --</option>';
        data.forEach(prov => {
            const opt = document.createElement('option');
            opt.value = prov.id;
            opt.textContent = prov.name;
            if (idProvSelected && prov.id == idProvSelected) opt.selected = true;
            selectProv.appendChild(opt);
        });

        // Si se seleccionó una provincia (automático o manual), cargar distritos
        if (selectProv.value) {
            cargarDistritos(selectProv.value, DISTRITO_EDITAR);
        }
    } catch (e) { console.error('Error:', e); }
}

// --- Función para cargar Distritos ---
async function cargarDistritos(idProv, idDistSelected = null) {
    const selectDist = document.getElementById('distrito_rep');
    if (!idProv) return;

    try {
        const res = await fetch(`${BASE_URL}ubigeo/distritos/${idProv}`);
        const data = await res.json();

        selectDist.innerHTML = '<option value="">-- Seleccionar --</option>';
        data.forEach(dist => {
            const opt = document.createElement('option');
            opt.value = dist.id;
            opt.textContent = dist.name;
            if (idDistSelected && dist.id == idDistSelected) opt.selected = true;
            selectDist.appendChild(opt);
        });
    } catch (e) { console.error('Error:', e); }
}

// --- Eventos de Escucha ---
document.getElementById('departamento_rep').addEventListener('change', function() {
    cargarProvincias(this.value);
});


document.getElementById('provincia_rep').addEventListener('change', function() {
    cargarDistritos(this.value);
});

document.getElementById('departamento_repdos').addEventListener('change', function () {
    cargarProvinciasEmpresa(this.value);
});

document.getElementById('provincia_repdos').addEventListener('change', function () {
    cargarDistritosEmpresa(this.value);
});



document.addEventListener('DOMContentLoaded', function () {

    // PERSONA
    const depPersona = document.getElementById('departamento_rep');

    if (depPersona.value !== "") {
        cargarProvincias(depPersona.value, PROVINCIA_EDITAR);
    }

    // EMPRESA
    const depEmpresa = document.getElementById('departamento_repdos');

    if (depEmpresa.value !== "") {
        cargarProvinciasEmpresa(depEmpresa.value, PROVINCIA_EDITARd);
    }

});



// ===============================
// EMPRESA - CARGAR PROVINCIAS
// ===============================
async function cargarProvinciasEmpresa(idDep, idProvSelected = null) {

    const selectProv = document.getElementById('provincia_repdos');
    const selectDist = document.getElementById('distrito_repdos');

    if (!idDep) {
        selectProv.innerHTML = '<option value="">-- Seleccionar --</option>';
        selectDist.innerHTML = '<option value="">-- Seleccionar --</option>';
        return;
    }

    try {

        const res = await fetch(`${BASE_URL}ubigeo/provincias/${idDep}`);
        const data = await res.json();

        selectProv.innerHTML = '<option value="">-- Seleccionar --</option>';

        data.forEach(prov => {

            const opt = document.createElement('option');

            opt.value = prov.id;
            opt.textContent = prov.name;

            if (idProvSelected && prov.id == idProvSelected) {
                opt.selected = true;
            }

            selectProv.appendChild(opt);

        });

        if (selectProv.value) {
            cargarDistritosEmpresa(selectProv.value, DISTRITO_EDITARX);
        }

    } catch (e) {
        console.error(e);
    }
}
// ===============================
// EMPRESA - CARGAR DISTRITOS
// ===============================
async function cargarDistritosEmpresa(idProv, idDistSelected = null) {

    const selectDist = document.getElementById('distrito_repdos');

    if (!idProv) return;

    try {

        const res = await fetch(`${BASE_URL}ubigeo/distritos/${idProv}`);
        const data = await res.json();

        selectDist.innerHTML = '<option value="">-- Seleccionar --</option>';

        data.forEach(dist => {

            const opt = document.createElement('option');

            opt.value = dist.id;
            opt.textContent = dist.name;

            if (idDistSelected && dist.id == idDistSelected) {
                opt.selected = true;
            }

            selectDist.appendChild(opt);

        });

    } catch (e) {
        console.error(e);
    }
}










// ════════════════════════════════════════════════════
// LÓGICA PARA AGREGAR SUCURSALES A LA TABLA
// ════════════════════════════════════════════════════

document.getElementById('formSucursal').addEventListener('submit', function (e) {
    e.preventDefault(); // Evitar que el formulario recargue la página

    // 1. Capturar los valores de los inputs del modal
    const nombre = document.getElementById('nombre_sucursal').value.trim();
    const direccion = document.getElementById('direccion_sucursal').value.trim();
    const telefono = document.getElementById('telefono_sucursal').value.trim();
    const correo = document.getElementById('correo_sucursal').value.trim();
    const representante = document.getElementById('representante_sucursal').value.trim();
    const estadoVal = document.getElementById('estado_label').value;
    const estadoTexto = document.getElementById('estado_label').options[document.getElementById('estado_label').selectedIndex].text;

    // Validar campos obligatorios
    if (nombre === '' || direccion === '' || telefono === '' || representante === '') {
        alert('Por favor, complete todos los campos marcados con (*)');
        return;
    }

    // 2. Referencia a la tabla y eliminar fila vacía si existe
    const tbody = document.getElementById('tbodySucursales');
    const filaVacia = document.getElementById('filaVacia');
    if (filaVacia) {
        filaVacia.remove();
    }

    // 3. Crear la nueva fila
    const nuevaFila = document.createElement('tr');
    
    // Usaremos inputs hidden para que al enviar el formulario principal "formPersona", 
    // los datos de las sucursales también se envíen al controlador.
    nuevaFila.innerHTML = `
        <td class="px-3">
            ${nombre}
            <input type="hidden" name="sucursales[nombre][]" value="${nombre}">
        </td>
        <td>
            ${direccion}
            <input type="hidden" name="sucursales[direccion][]" value="${direccion}">
        </td>
        <td>
            ${telefono}
            <input type="hidden" name="sucursales[telefono][]" value="${telefono}">
        </td>
        <td>
            ${correo}
            <input type="hidden" name="sucursales[correo][]" value="${correo}">
            <input type="hidden" name="sucursales[representante][]" value="${representante}">
            <input type="hidden" name="sucursales[estado][]" value="${estadoVal}">
        </td>
        <td class="text-center">
            <span class="badge ${estadoVal == '1' ? 'bg-success' : 'bg-secondary'}">${estadoTexto}</span>
        </td>
        <td class="text-center">
            <button type="button" class="btn btn-warning btn-sm btn-editar-sucursal  data-bs-toggle="modal" data-bs-target="#ModalSucursal" ">
                <i class="fa-solid fa-pen-to-square"></i>
            <button type="button" class="btn btn-danger btn-sm btn-eliminar-sucursal">
                <i class="fa-solid fa-trash"></i>
            </button>
        </td>
    `;
    

    // 4. Agregar la fila al cuerpo de la tabla
    tbody.appendChild(nuevaFila);

    // 5. Limpiar el formulario y cerrar el modal
    this.reset();
    const modalElement = document.getElementById('ModalSucursal');
    const modal = bootstrap.Modal.getInstance(modalElement);
    modal.hide();
});

document.getElementById('tablaSucursales').addEventListener('click', function (e) {
    if (e.target.closest('.btn-editar-sucursal')) {
        const fila = e.target.closest('tr');
        const nombre = fila.querySelector('td:nth-child(1)').textContent.trim();
        const direccion = fila.querySelector('td:nth-child(2)').textContent.trim();
        const telefono = fila.querySelector('td:nth-child(3)').textContent.trim();
        const correo = fila.querySelector('td:nth-child(4)').textContent.trim();
        const representante = fila.querySelector('td:nth-child(4) input[name="sucursales[representante][]"]').value;
        const estadoVal = fila.querySelector('td:nth-child(4) input[name="sucursales[estado][]"]').value;

        document.getElementById('nombre_sucursal').value = nombre;
        document.getElementById('direccion_sucursal').value = direccion;
        document.getElementById('telefono_sucursal').value = telefono;
        document.getElementById('correo_sucursal').value = correo;
        document.getElementById('representante_sucursal').value = representante;
        document.getElementById('estado_label').value = estadoVal;

        // Eliminar la fila actual para que al guardar se actualice con los nuevos datos
        fila.remove();

        // Mostrar el modal
        const modalElement = document.getElementById('ModalSucursal');
        const modal = new bootstrap.Modal(modalElement);
        modal.show();
    }
});


// Lógica para eliminar una fila de la tabla
document.getElementById('tbodySucursales').addEventListener('click', function (e) {
    if (e.target.closest('.btn-eliminar-sucursal')) {
        const fila = e.target.closest('tr');
        fila.remove();

        // Si la tabla queda vacía, volver a mostrar el mensaje de "No hay datos"
        const tbody = document.getElementById('tbodySucursales');
        if (tbody.children.length === 0) {
            tbody.innerHTML = `
                <tr id="filaVacia">
                    <td colspan="6" class="text-center text-muted py-3">No hay sucursales agregadas</td>
                </tr>
            `;
        }
    }
});
</script>

            <?php
            $flashMsg = session()->getFlashdata('msg') ?? session()->getFlashdata('error');
            $flashTipo = session()->getFlashdata('tipo') ?? 'danger';
            $flashClass = ($flashTipo === 'warning') ? 'alerta-warning' : 'alerta-error';
            ?>
            <?php if (!empty($flashMsg)): ?>
                <div class="<?= esc($flashClass) ?>" role="alert">
                    <?= esc($flashMsg) ?>
                </div>
            <?php endif; ?>

            <form class="formularioxd" method="post" action="<?= site_url('login/auth') ?>">
                <?= csrf_field() ?>

                <div class="form-group-modern">
                    <label for="username">Usuario</label>
                    <div class="input-with-icon">
                        <input type="text" id="username" name="username" placeholder="example@email.com" required />
                        <i class="fa fa-user" aria-hidden="true"></i>
                    </div>
                </div>

                <div class="form-group-modern">
                    <label for="password">Contraseña</label>
                    <div class="input-with-icon">
                        <input type="password" id="password" name="password" placeholder="••••••••" required />
                        <i class="fa-solid fa-eye" id="togglePassword"></i>
                    </div>
                </div>

                <button type="submit" class="btn-primary-modern">Entrar</button>

                <div class="footer-links">
                    <a href="<?= base_url('/') ?>" class="back-link">Volver al inicio</a>
                </div>
            </form>

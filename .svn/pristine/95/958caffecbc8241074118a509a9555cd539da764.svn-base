<!-- ══════════════════════════════════════════════════════════════ -->
<!-- JAVASCRIPT                                                     -->
<!-- ══════════════════════════════════════════════════════════════ -->
<script>
    const BASE_URL = '<?= base_url() ?>';
    const csrfFieldName = '<?= csrf_token() ?>';
    const modalNuevoPermisoElement = document.getElementById('modalNuevoPermiso');
    const modalEditarPermisoElement = document.getElementById('modalEditarPermiso');
    const formNuevoPermiso = document.getElementById('formNuevoPermiso');
    const formEditarPermiso = document.getElementById('formEditarPermiso');

    function getCsrfValue(form = document) {
        const csrfInput = form.querySelector(`input[name="${csrfFieldName}"]`);
        return csrfInput ? csrfInput.value : '';
    }

    async function fetchJson(url, options = {}) {
        const response = await fetch(url, options);
        const data = await response.json().catch(() => ({
            success: false,
            message: 'La respuesta del servidor no fue válida.'
        }));

        if (!response.ok) {
            throw new Error(data.message || 'La solicitud no se pudo completar.');
        }

        return data;
    }

    function resetEditModal() {
        formEditarPermiso.reset();
        document.getElementById('edit_id_permiso').value = '';
        document.getElementById('edit_rol_nombre').textContent = '—';
        document.getElementById('edit_menu_nombre').textContent = '—';
    }

    modalNuevoPermisoElement.addEventListener('hidden.bs.modal', () => formNuevoPermiso.reset());
    modalEditarPermisoElement.addEventListener('hidden.bs.modal', resetEditModal);

    // ── GUARDAR NUEVO ──────────────────────────────────────────────
    formNuevoPermiso.addEventListener('submit', async function (e) {
        e.preventDefault();
        const formData = new FormData(this);

        try {
            const res = await fetchJson(BASE_URL + 'permisos/guardar', {
                method: 'POST',
                headers: { 'X-Requested-With': 'XMLHttpRequest' },
                body: formData
            });

            if (!res.success) {
                window.adminUI.notify(res.message || 'Error al guardar.', 'danger');
                return;
            }

            const modalNuevoPermiso = bootstrap.Modal.getInstance(modalNuevoPermisoElement);
            if (modalNuevoPermiso) {
                modalNuevoPermiso.hide();
            }
            location.reload();
        } catch (error) {
            window.adminUI.notify(error.message || 'Error de conexión.', 'danger');
        }
    });

    // ── ABRIR MODAL EDITAR ────────────────────────────────────────
    document.querySelectorAll('.btn-editar').forEach(btn => {
        btn.addEventListener('click', function () {
            const id = this.dataset.id;
            resetEditModal();

            fetchJson(BASE_URL + 'permisos/obtener/' + id, {
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            })
                .then(res => {
                    if (!res.success) {
                        window.adminUI.notify(res.message || 'No se pudo cargar el permiso.', 'danger');
                        return;
                    }

                    const p = res.permiso;

                    document.getElementById('edit_id_permiso').value = p.id_permiso;
                    document.getElementById('edit_rol_nombre').textContent = p.rol_nombre ?? '—';
                    document.getElementById('edit_menu_nombre').textContent = p.menu_nombre ?? '—';
                    document.getElementById('edit_read').checked = Number(p.read) === 1;
                    document.getElementById('edit_insert').checked = Number(p.insert) === 1;
                    document.getElementById('edit_update').checked = Number(p.update) === 1;
                    document.getElementById('edit_delete').checked = Number(p.delete) === 1;

                    new bootstrap.Modal(modalEditarPermisoElement).show();
                })
                .catch(error => window.adminUI.notify(error.message || 'Error al cargar el permiso.', 'danger'));
        });
    });

    // ── GUARDAR EDICIÓN ───────────────────────────────────────────
    formEditarPermiso.addEventListener('submit', async function (e) {
        e.preventDefault();
        const id = document.getElementById('edit_id_permiso').value;
        const formData = new FormData(this);

        try {
            const res = await fetchJson(BASE_URL + 'permisos/editar/' + id, {
                method: 'POST',
                headers: { 'X-Requested-With': 'XMLHttpRequest' },
                body: formData
            });

            if (!res.success) {
                window.adminUI.notify(res.message || 'Error al actualizar.', 'danger');
                return;
            }

            const modalEditarPermiso = bootstrap.Modal.getInstance(modalEditarPermisoElement);
            if (modalEditarPermiso) {
                modalEditarPermiso.hide();
            }
            location.reload();
        } catch (error) {
            window.adminUI.notify(error.message || 'Error de conexión.', 'danger');
        }
    });

    // ── ELIMINAR ──────────────────────────────────────────────────
    document.querySelectorAll('.btn-eliminar').forEach(btn => {
        btn.addEventListener('click', async function () {
            const confirmed = await window.adminUI.confirm('¿Eliminar este permiso?', { okText: 'Eliminar' });
            if (!confirmed) return;
            const id = this.dataset.id;

            fetchJson(BASE_URL + 'permisos/eliminar/' + id, {
                method: 'POST',
                headers: {
                    'X-Requested-With': 'XMLHttpRequest',
                    'Content-Type': 'application/x-www-form-urlencoded'
                },
                body: new URLSearchParams({
                    [csrfFieldName]: getCsrfValue(formNuevoPermiso)
                }).toString()
            })
                .then(res => {
                    if (!res.success) {
                        window.adminUI.notify(res.message || 'Error al eliminar.', 'danger');
                        return;
                    }

                    location.reload();
                })
                .catch(error => window.adminUI.notify(error.message || 'Error de conexión.', 'danger'));
        });
    });
</script>

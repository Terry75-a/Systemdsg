<?php 

namespace App\Models;

use CodeIgniter\Model;

class ClientesaddModel extends Model
{    
    protected $table = 'personas';
    protected $primaryKey = 'id_persona';
    protected $allowedFields = [
        'nombre',
        'apellido_materno',
        'apellido_paterno',
        'dni',
        'telefono',
        'correo',
        'direccion',
        'fecha_nacimiento',
        'id_pais',
        'id_departamento',
        'id_provincia',
        'id_tipo_documento',
        'id_distrito',
        'created_at',
    ];
    public $useTimestamps = false;
}

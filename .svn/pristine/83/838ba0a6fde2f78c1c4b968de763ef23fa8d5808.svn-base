                                            <button type="button"
                                                class="btn <?= (int) ($usuario->estado ?? 0) === 1 ? 'btn-outline-warning' : 'btn-outline-success' ?> btn-toggle-estado"
                                                data-id="<?= esc($usuario->id_usuario) ?>"
                                                data-estado="<?= esc($usuario->estado) ?>"
                                                title="<?= (int) ($usuario->estado ?? 0) === 1 ? 'Desactivar' : 'Activar' ?> usuario" aria-label="<?= (int) ($usuario->estado ?? 0) === 1 ? 'Desactivar' : 'Activar' ?> usuario <?= esc($usuario->username) ?>">

<script>
    const BASE_URL = '<?= rtrim(base_url(), '/') ?>/';
    const CSRF_HEADER = 'X-CSRF-TOKEN';
    const CSRF_HASH = '<?= csrf_hash() ?>';
    const MENUS = <?= json_encode($menusPayload, JSON_UNESCAPED_UNICODE) ?>;

    function escapeHtml(value) {
        return String(value ?? '')
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#039;');
    }

    function buildAlert(type, content) {
        return `<div class="alert alert-${type} alert-dismissible fade show" role="alert">${content}<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>`;
    }

    function renderErrors(errors = {}) {
        const items = Object.values(errors).filter(Boolean);
        if (!items.length) {
            return 'Ocurrió un error inesperado.';
        }

        return `<ul class="mb-0 ps-3">${items.map(item => `<li>${escapeHtml(item)}</li>`).join('')}</ul>`;
    }

    function setAlert(containerId, type, html) {
        const container = document.getElementById(containerId);
        if (!container) {
            return;
        }

        container.innerHTML = html ? buildAlert(type, html) : '';
    }

    function clearAlert(containerId) {
        setAlert(containerId, '', '');
    }

    function fullName(usuario) {
        return [usuario.nombre, usuario.apellido_paterno, usuario.apellido_materno]
            .filter(Boolean)
            .join(' ')
            .trim();
    }

    function fillUserForm(prefix, usuario) {
        document.getElementById(`${prefix}_nombre`).value = usuario.nombre ?? '';
        document.getElementById(`${prefix}_apellido_paterno`).value = usuario.apellido_paterno ?? '';
        document.getElementById(`${prefix}_apellido_materno`).value = usuario.apellido_materno ?? '';
        document.getElementById(`${prefix}_dni`).value = usuario.dni ?? '';
        document.getElementById(`${prefix}_correo`).value = usuario.correo ?? '';
        document.getElementById(`${prefix}_telefono`).value = usuario.telefono ?? '';
        document.getElementById(`${prefix}_username`).value = usuario.username ?? '';
        document.getElementById(`${prefix}_id_rol`).value = usuario.id_rol ?? '';
    }

    function renderPermissions(permisos = []) {
        const tbody = document.getElementById('tablaPermisosBody');
        const permisosMap = new Map(permisos.map(permiso => [Number(permiso.menu_id), permiso]));

        if (!MENUS.length) {
            tbody.innerHTML = '<tr><td colspan="5" class="text-center text-muted py-4">No hay menús configurados para asignar permisos.</td></tr>';
            return;
        }

        tbody.innerHTML = MENUS.map(menu => {
            const permiso = permisosMap.get(Number(menu.id)) ?? {};

            return `
                <tr data-menu-id="${menu.id}">
                    <td>${escapeHtml(menu.nombre)}</td>
                    <td class="text-center"><input class="form-check-input permiso-check" type="checkbox" data-action="read" ${Number(permiso.read) === 1 ? 'checked' : ''}></td>
                    <td class="text-center"><input class="form-check-input permiso-check" type="checkbox" data-action="insert" ${Number(permiso.insert) === 1 ? 'checked' : ''}></td>
                    <td class="text-center"><input class="form-check-input permiso-check" type="checkbox" data-action="update" ${Number(permiso.update) === 1 ? 'checked' : ''}></td>
                    <td class="text-center"><input class="form-check-input permiso-check" type="checkbox" data-action="delete" ${Number(permiso.delete) === 1 ? 'checked' : ''}></td>
                </tr>
            `;
        }).join('');
    }

    async function fetchJson(url, options = {}) {
        const response = await fetch(url, {
            headers: {
                'X-Requested-With': 'XMLHttpRequest',
                ...options.headers,
            },
            ...options,
        });

        return response.json();
    }

    document.getElementById('formNuevoUsuario').addEventListener('submit', async function (event) {
        event.preventDefault();
        clearAlert('alertNuevoUsuario');

        const formData = new FormData(this);

        try {
            const response = await fetchJson(`${BASE_URL}usuarios/registrar`, {
                method: 'POST',
                body: formData,
            });

            if (!response.success) {
                setAlert('alertNuevoUsuario', 'danger', renderErrors(response.errors ?? { general: response.message }));
                return;
            }

            this.reset();
            bootstrap.Modal.getInstance(document.getElementById('modalNuevoUsuario')).hide();
            location.reload();
        } catch (error) {
            setAlert('alertNuevoUsuario', 'danger', 'No se pudo registrar el usuario.');
            console.error(error);
        }
    });

    document.querySelectorAll('.btn-editar-usuario').forEach(button => {
        button.addEventListener('click', async function () {
            clearAlert('alertEditarUsuario');

            try {
                const response = await fetchJson(`${BASE_URL}usuarios/obtener/${this.dataset.id}`);

                if (!response.success) {
                    setAlert('alertEditarUsuario', 'danger', escapeHtml(response.message ?? 'No se pudo cargar el usuario.'));
                    new bootstrap.Modal(document.getElementById('modalEditarUsuario')).show();
                    return;
                }

                document.getElementById('editar_id_usuario').value = response.data.id_usuario;
                document.getElementById('editar_password').value = '';
                fillUserForm('editar', response.data);

                new bootstrap.Modal(document.getElementById('modalEditarUsuario')).show();
            } catch (error) {
                setAlert('alertEditarUsuario', 'danger', 'No se pudo cargar el usuario.');
                new bootstrap.Modal(document.getElementById('modalEditarUsuario')).show();
                console.error(error);
            }
        });
    });

    document.getElementById('formEditarUsuario').addEventListener('submit', async function (event) {
        event.preventDefault();
        clearAlert('alertEditarUsuario');

        const idUsuario = document.getElementById('editar_id_usuario').value;
        const formData = new FormData(this);

        try {
            const response = await fetchJson(`${BASE_URL}usuarios/actualizar/${idUsuario}`, {
                method: 'POST',
                body: formData,
            });

            if (!response.success) {
                setAlert('alertEditarUsuario', 'danger', renderErrors(response.errors ?? { general: response.message }));
                return;
            }

            bootstrap.Modal.getInstance(document.getElementById('modalEditarUsuario')).hide();
            location.reload();
        } catch (error) {
            setAlert('alertEditarUsuario', 'danger', 'No se pudo actualizar el usuario.');
            console.error(error);
        }
    });

    document.querySelectorAll('.btn-permisos-usuario').forEach(button => {
        button.addEventListener('click', async function () {
            clearAlert('alertPermisosUsuario');

            try {
                const response = await fetchJson(`${BASE_URL}usuarios/obtener/${this.dataset.id}`);

                if (!response.success) {
                    setAlert('alertPermisosUsuario', 'danger', escapeHtml(response.message ?? 'No se pudieron cargar los permisos.'));
                    new bootstrap.Modal(document.getElementById('modalPermisosUsuario')).show();
                    return;
                }

                const usuario = response.data;
                document.getElementById('permisos_id_usuario').value = usuario.id_usuario;
                document.getElementById('permisoUsuarioLabel').textContent = `${usuario.username} · ${fullName(usuario) || 'Sin nombre registrado'}`;
                document.getElementById('permisoRolLabel').textContent = usuario.rol_nombre ?? 'Sin rol';
                renderPermissions(usuario.permisos ?? []);

                new bootstrap.Modal(document.getElementById('modalPermisosUsuario')).show();
            } catch (error) {
                setAlert('alertPermisosUsuario', 'danger', 'No se pudieron cargar los permisos.');
                new bootstrap.Modal(document.getElementById('modalPermisosUsuario')).show();
                console.error(error);
            }
        });
    });

    document.getElementById('formPermisosUsuario').addEventListener('submit', async function (event) {
        event.preventDefault();
        clearAlert('alertPermisosUsuario');

        const idUsuario = document.getElementById('permisos_id_usuario').value;
        const payload = Array.from(document.querySelectorAll('#tablaPermisosBody tr[data-menu-id]')).map(row => ({
            menu_id: Number(row.dataset.menuId),
            read: row.querySelector('[data-action="read"]').checked ? 1 : 0,
            insert: row.querySelector('[data-action="insert"]').checked ? 1 : 0,
            update: row.querySelector('[data-action="update"]').checked ? 1 : 0,
            delete: row.querySelector('[data-action="delete"]').checked ? 1 : 0,
        }));

        try {
            const response = await fetchJson(`${BASE_URL}usuarios/permisos/${idUsuario}`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    [CSRF_HEADER]: CSRF_HASH,
                },
                body: JSON.stringify(payload),
            });

            if (!response.success) {
                setAlert('alertPermisosUsuario', 'danger', escapeHtml(response.message ?? 'No se pudieron guardar los permisos.'));
                return;
            }

            bootstrap.Modal.getInstance(document.getElementById('modalPermisosUsuario')).hide();
            location.reload();
        } catch (error) {
            setAlert('alertPermisosUsuario', 'danger', 'No se pudieron guardar los permisos.');
            console.error(error);
        }
    });

    document.querySelectorAll('.btn-toggle-estado').forEach(button => {
        button.addEventListener('click', async function () {
            const accion = Number(this.dataset.estado) === 1 ? 'desactivar' : 'activar';

            const confirmed = await window.adminUI.confirm(`¿Querés ${accion} este usuario?`, {
                okText: accion === 'desactivar' ? 'Desactivar' : 'Activar'
            });

            if (!confirmed) {
                return;
            }

            const formData = new FormData();
            formData.append('<?= csrf_token() ?>', CSRF_HASH);

            try {
                const response = await fetchJson(`${BASE_URL}usuarios/estado/${this.dataset.id}`, {
                    method: 'POST',
                    body: formData,
                });

                if (!response.success) {
                    window.adminUI.notify(response.message ?? 'No se pudo actualizar el estado.', 'danger');
                    return;
                }

                location.reload();
            } catch (error) {
                window.adminUI.notify('No se pudo actualizar el estado.', 'danger');
                console.error(error);
            }
        });
    });
</script>

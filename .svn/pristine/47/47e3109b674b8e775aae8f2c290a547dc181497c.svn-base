<!-- ══════════════════════════════════════════════════════════════ -->
<!-- JAVASCRIPT — Conecta la vista con los 4 métodos del controlador -->
<!-- ══════════════════════════════════════════════════════════════ -->
<script>
const BASE_URL  = '<?= base_url() ?>/';
let csrfName    = '<?= csrf_token() ?>';
let csrfHash    = '<?= csrf_hash() ?>';

// Función auxiliar para construir el FormData con CSRF
function buildForm(data = {}) {
    const fd = new FormData();
    fd.append(csrfName, csrfHash);
    for (const [key, val] of Object.entries(data)) {
        fd.append(key, val);
    }
    return fd;
}

// Función auxiliar para actualizar el CSRF después de cada request
// (CI4 rota el token en cada petición POST)
function refreshCsrf(response) {
    if (response.headers.get('X-CSRF-TOKEN-NAME')) {
        csrfName = response.headers.get('X-CSRF-TOKEN-NAME');
        csrfHash = response.headers.get('X-CSRF-TOKEN');
    }
}

// ── 1. GUARDAR NUEVO PERMISO ──────────────────────────────────────
// Ruta: POST /permisos/guardar
// Controlador: PermisosController::guardar()
document.getElementById('btnGuardarNuevo').addEventListener('click', async function () {
    const alerta  = document.getElementById('alertaNuevo');
    const spinner = document.getElementById('spinnerNuevo');
    const icono   = document.getElementById('iconoNuevo');

    const persona = document.getElementById('nuevo_persona').value;
    const rol     = document.getElementById('nuevo_rol').value;
    const menu    = document.getElementById('nuevo_menu').value;

    // Validar que los 3 selects tengan valor
    if (!persona || !rol || !menu) {
        alerta.innerHTML = `<div class="alert alert-warning py-2 mt-2">
            <i class="fa-solid fa-triangle-exclamation me-1"></i>
            Debes seleccionar Persona, Rol y Módulo.
        </div>`;
        return;
    }

    spinner.classList.remove('d-none');
    icono.classList.add('d-none');
    this.disabled = true;
    alerta.innerHTML = '';

    const fd = buildForm({
        id_persona : persona,
        id_rol     : rol,
        menu_id    : menu,
        read       : document.getElementById('nuevo_read').checked   ? 1 : 0,
        insert     : document.getElementById('nuevo_insert').checked ? 1 : 0,
        update     : document.getElementById('nuevo_update').checked ? 1 : 0,
        delete     : document.getElementById('nuevo_delete').checked ? 1 : 0,
    });

    try {
        const res  = await fetch(BASE_URL + 'permisos/guardar', { method: 'POST', body: fd });
        const data = await res.json();

        alerta.innerHTML = data.success
            ? `<div class="alert alert-success py-2 mt-2"><i class="fa-solid fa-circle-check me-1"></i>${data.message}</div>`
            : `<div class="alert alert-danger py-2 mt-2"><i class="fa-solid fa-circle-xmark me-1"></i>${data.message}</div>`;

        if (data.success) {
            setTimeout(() => location.reload(), 1000);
        }

    } catch (e) {
        alerta.innerHTML = `<div class="alert alert-danger py-2 mt-2">Error de conexión.</div>`;
    } finally {
        spinner.classList.add('d-none');
        icono.classList.remove('d-none');
        this.disabled = false;
    }
});

// ── 2. ABRIR MODAL EDITAR → pre-llenar datos ──────────────────────
// Ruta: GET /permisos/obtener/{id}
// Controlador: PermisosController::obtener()
document.querySelectorAll('.btnEditar').forEach(function (btn) {
    btn.addEventListener('click', async function () {
        const id      = this.dataset.id;
        const alerta  = document.getElementById('alertaEditar');
        alerta.innerHTML = '';

        try {
            // Pedir los datos del permiso al controlador
            const res  = await fetch(BASE_URL + 'permisos/obtener/' + id);
            const data = await res.json();

            if (!data.success) {
                alert('No se pudo cargar el permiso: ' + data.message);
                return;
            }

            const p = data.permiso;

            // Guardar el id en el campo oculto (lo usa btnGuardarEdicion)
            document.getElementById('edit_id_permiso').value = p.id_permiso;

            // Mostrar info de la fila (solo lectura)
            document.getElementById('edit_persona_label').textContent =
                (p.persona_nombre ?? '') + ' ' + (p.apellido_paterno ?? '');
            document.getElementById('edit_rol_label').textContent   = p.rol_nombre   ?? 'Sin rol';
            document.getElementById('edit_menu_label').textContent  = p.menu_nombre  ?? 'Sin módulo';

            // Marcar/desmarcar los switches con los valores actuales
            document.getElementById('edit_read').checked   = p.read   == 1;
            document.getElementById('edit_insert').checked = p.insert == 1;
            document.getElementById('edit_update').checked = p.update == 1;
            document.getElementById('edit_delete').checked = p.delete == 1;

            // Abrir el modal de edición
            new bootstrap.Modal(document.getElementById('modalEditar')).show();

        } catch (e) {
            alert('Error de conexión al cargar el permiso.');
        }
    });
});

// ── 3. GUARDAR EDICIÓN ────────────────────────────────────────────
// Ruta: POST /permisos/editar/{id}
// Controlador: PermisosController::editar()
// Solo actualiza read/insert/update/delete
document.getElementById('btnGuardarEdicion').addEventListener('click', async function () {
    const id      = document.getElementById('edit_id_permiso').value;
    const alerta  = document.getElementById('alertaEditar');
    const spinner = document.getElementById('spinnerEditar');
    const icono   = document.getElementById('iconoEditar');

    spinner.classList.remove('d-none');
    icono.classList.add('d-none');
    this.disabled = true;
    alerta.innerHTML = '';

    const fd = buildForm({
        read   : document.getElementById('edit_read').checked   ? 1 : 0,
        insert : document.getElementById('edit_insert').checked ? 1 : 0,
        update : document.getElementById('edit_update').checked ? 1 : 0,
        delete : document.getElementById('edit_delete').checked ? 1 : 0,
    });

    try {
        const res  = await fetch(BASE_URL + 'permisos/editar/' + id, { method: 'POST', body: fd });
        const data = await res.json();

        alerta.innerHTML = data.success
            ? `<div class="alert alert-success py-2 mt-2"><i class="fa-solid fa-circle-check me-1"></i>${data.message}</div>`
            : `<div class="alert alert-danger py-2 mt-2"><i class="fa-solid fa-circle-xmark me-1"></i>${data.message}</div>`;

        if (data.success) {
            setTimeout(() => location.reload(), 1000);
        }

    } catch (e) {
        alerta.innerHTML = `<div class="alert alert-danger py-2 mt-2">Error de conexión.</div>`;
    } finally {
        spinner.classList.add('d-none');
        icono.classList.remove('d-none');
        this.disabled = false;
    }
});

// ── 4. ELIMINAR ───────────────────────────────────────────────────
// Ruta: POST /permisos/eliminar/{id}
// Controlador: PermisosController::eliminar()
document.querySelectorAll('.btnEliminar').forEach(function (btn) {
    btn.addEventListener('click', async function () {
        const id = this.dataset.id;

        if (!confirm('¿Seguro que deseas eliminar este permiso?')) return;

        try {
            const fd  = buildForm();
            const res = await fetch(BASE_URL + 'permisos/eliminar/' + id, { method: 'POST', body: fd });
            const data = await res.json();

            if (data.success) {
                // Quitar la fila de la tabla sin recargar
                this.closest('tr').remove();
            } else {
                alert('Error al eliminar: ' + data.message);
            }

        } catch (e) {
            alert('Error de conexión al eliminar.');
        }
    });
});

// ── 5. LIMPIAR modal NUEVO al cerrarlo ────────────────────────────
document.getElementById('modalNuevo').addEventListener('hidden.bs.modal', function () {
    document.getElementById('formNuevo').reset();
    document.getElementById('alertaNuevo').innerHTML = '';
});

// ── 6. LIMPIAR modal EDITAR al cerrarlo ───────────────────────────
document.getElementById('modalEditar').addEventListener('hidden.bs.modal', function () {
    document.getElementById('alertaEditar').innerHTML = '';
});
</script>

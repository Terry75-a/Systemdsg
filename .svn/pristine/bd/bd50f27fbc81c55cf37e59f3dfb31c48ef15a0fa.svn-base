<!-- JAVASCRIPT — Búsqueda por DNI y RUC + Ubigeo en cascada       -->
<!-- ══════════════════════════════════════════════════════════════ -->
<script>
// ── TOKEN CSRF (necesario para todos los POST en CI4)
const csrfName  = '<?= csrf_token() ?>';
const csrfHash  = '<?= csrf_hash() ?>';

// ── BASE URL del proyecto
const BASE_URL  = '<?= base_url() ?>';

// ════════════════════════════════════════════════════
// BÚSQUEDA POR DNI
// El controlador devuelve: { success, nombres, apellido_paterno, apellido_materno }
// Ruta: POST /personas/buscar-dni
// ════════════════════════════════════════════════════
document.getElementById('btnBuscarDni').addEventListener('click', async function () {

    const dni = document.getElementById('dni').value.trim();
    const alerta = document.getElementById('alertaDni');

    // Limpiar alerta anterior
    alerta.innerHTML = '';

    // Validar que el DNI tenga exactamente 8 dígitos
    if (!/^\d{8}$/.test(dni)) {
        alerta.innerHTML = `<small class="text-danger">
            <i class="fa-solid fa-triangle-exclamation"></i>
            El DNI debe tener exactamente 8 dígitos numéricos.
        </small>`;
        return;
    }

    // Mostrar spinner, ocultar ícono
    document.getElementById('spinnerDni').classList.remove('d-none');
    document.getElementById('iconoDni').classList.add('d-none');
    this.disabled = true;

    try {
        const formData = new FormData();
        formData.append('dni', dni);
        formData.append(csrfName, csrfHash); // token CSRF obligatorio en CI4

        // POST a la ruta definida en Routes.php
        const response = await fetch(`${BASE_URL}personas/buscar-dni`, {
            method: 'POST',
            body: formData
        });

        const data = await response.json();

        if (data.success) {
            // ✅ Llenar los campos automáticamente con los datos del API
            document.getElementById('nombre').value           = data.nombres          ?? '';
            document.getElementById('apellido_paterno').value = data.apellido_paterno ?? '';
            document.getElementById('apellido_materno').value = data.apellido_materno ?? '';

            // Mostrar mensaje de éxito
            alerta.innerHTML = `<small class="text-success">
                <i class="fa-solid fa-circle-check"></i>
                Datos encontrados correctamente.
            </small>`;

            // Enfocar el campo teléfono para que el usuario continúe llenando
            document.getElementById('telefono').focus();

        } else {
            // ❌ DNI no encontrado — limpiar campos y mostrar error
            document.getElementById('nombre').value           = '';
            document.getElementById('apellido_paterno').value = '';
            document.getElementById('apellido_materno').value = '';

            alerta.innerHTML = `<small class="text-danger">
                <i class="fa-solid fa-circle-xmark"></i>
                ${data.message ?? 'DNI no encontrado o error en el servicio.'}
            </small>`;
        }

    } catch (error) {
        alerta.innerHTML = `<small class="text-danger">
            <i class="fa-solid fa-circle-xmark"></i>
            Error de conexión. Intenta nuevamente.
        </small>`;
        console.error('Error en búsqueda DNI:', error);

    } finally {
        // Restaurar botón y spinner siempre, haya error o no
        document.getElementById('spinnerDni').classList.add('d-none');
        document.getElementById('iconoDni').classList.remove('d-none');
        this.disabled = false;
    }
});

// También buscar al presionar Enter en el campo DNI
document.getElementById('dni').addEventListener('keydown', function (e) {
    if (e.key === 'Enter') {
        e.preventDefault(); // evitar submit del form
        document.getElementById('btnBuscarDni').click();
    }
});

// ════════════════════════════════════════════════════
// BÚSQUEDA POR RUC
// El controlador devuelve: { success, razon, direccion }
// Ruta: POST /personas/buscar-ruc
// ════════════════════════════════════════════════════
document.getElementById('btnBuscarRuc').addEventListener('click', async function () {

    const ruc    = document.getElementById('ruc').value.trim();
    const alerta = document.getElementById('alertaRuc');

    alerta.innerHTML = '';

    // Validar que el RUC tenga 11 dígitos
    if (!/^\d{11}$/.test(ruc)) {
        alerta.innerHTML = `<small class="text-danger">
            <i class="fa-solid fa-triangle-exclamation"></i>
            El RUC debe tener exactamente 11 dígitos numéricos.
        </small>`;
        return;
    }

    document.getElementById('spinnerRuc').classList.remove('d-none');
    document.getElementById('iconoRuc').classList.add('d-none');
    this.disabled = true;

    try {
        const formData = new FormData();
        formData.append('ruc', ruc);
        formData.append(csrfName, csrfHash);

        const response = await fetch(`${BASE_URL}personas/buscar-ruc`, {
            method: 'POST',
            body: formData
        });

        const data = await response.json();

        if (data.success) {
            document.getElementById('razon_social').value    = data.razon    ?? '';
            document.getElementById('direccion_fiscal').value = data.direccion ?? '';

            alerta.innerHTML = `<small class="text-success">
                <i class="fa-solid fa-circle-check"></i>
                Empresa encontrada correctamente.
            </small>`;

        } else {
            document.getElementById('razon_social').value    = '';
            document.getElementById('direccion_fiscal').value = '';

            alerta.innerHTML = `<small class="text-danger">
                <i class="fa-solid fa-circle-xmark"></i>
                ${data.message ?? 'RUC no encontrado o error en el servicio.'}
            </small>`;
        }

    } catch (error) {
        alerta.innerHTML = `<small class="text-danger">
            <i class="fa-solid fa-circle-xmark"></i>
            Error de conexión. Intenta nuevamente.
        </small>`;
        console.error('Error en búsqueda RUC:', error);

    } finally {
        document.getElementById('spinnerRuc').classList.add('d-none');
        document.getElementById('iconoRuc').classList.remove('d-none');
        this.disabled = false;
    }
});

// También buscar al presionar Enter en el campo RUC
document.getElementById('ruc').addEventListener('keydown', function (e) {
    if (e.key === 'Enter') {
        e.preventDefault();
        document.getElementById('btnBuscarRuc').click();
    }
});

// ════════════════════════════════════════════════════
// UBIGEO EN CASCADA (Departamento → Provincia → Distrito)
// Ruta: GET /ubigeo/provincias/{id_dep}
// Ruta: GET /ubigeo/distritos/{id_prov}
// ════════════════════════════════════════════════════
document.getElementById('departamento_rep').addEventListener('change', async function () {
    const idDep        = this.value;
    const selectProv   = document.getElementById('provincia_rep');
    const selectDist   = document.getElementById('distrito_rep');

    // Resetear provincia y distrito
    selectProv.innerHTML = '<option value="">-- Seleccionar --</option>';
    selectDist.innerHTML = '<option value="">-- Seleccionar --</option>';

    if (!idDep) return;

    try {
        const res  = await fetch(`${BASE_URL}ubigeo/provincias/${idDep}`);
        const data = await res.json();

        data.forEach(prov => {
            const opt = document.createElement('option');
            opt.value       = prov.id;
            opt.textContent = prov.name;
            selectProv.appendChild(opt);
        });
    } catch (e) {
        console.error('Error cargando provincias:', e);
    }
});

document.getElementById('provincia_rep').addEventListener('change', async function () {
    const idProv     = this.value;
    const selectDist = document.getElementById('distrito_rep');

    selectDist.innerHTML = '<option value="">-- Seleccionar --</option>';

    if (!idProv) return;

    try {
        const res  = await fetch(`${BASE_URL}ubigeo/distritos/${idProv}`);
        const data = await res.json();

        data.forEach(dist => {
            const opt = document.createElement('option');
            opt.value       = dist.id;
            opt.textContent = dist.name;
            selectDist.appendChild(opt);
        });
    } catch (e) {
        console.error('Error cargando distritos:', e);
    }
});
</script>

<?php
namespace App\Controllers;

use App\Models\PerfilModel;
use CodeIgniter\Controller;

class PerfilController extends Controller
{
    public function index()
    {
        $session = session();
        $idUsuario = $session->get('id_usuario'); 
        $data['titulo'] = 'Mi Perfil';
        session()->set('last_page', 'perfil');
        
        $perfilModel = new PerfilModel();
        $data['perfil'] = $perfilModel->getPerfil($idUsuario);
        
        echo view('layouts/header');
        echo view('layouts/sidebar'); // <-- primero sidebar
        echo view('layouts/topbar', $data);
        echo view('perfil', $data);



        
    }

    public function actualizar()
    {
        $perfilModel = new PerfilModel();

        $idUsuario = $this->request->getPost('id_usuario');
        $idPersona = $this->request->getPost('id_persona');

        $dataUsuario = [
            'username' => $this->request->getPost('username')
        ];

        $password = $this->request->getPost('password');
        if (!empty($password)) {
            $dataUsuario['password'] = password_hash($password, PASSWORD_DEFAULT);
        }

        $dataPersona = [
            'id_persona' => $idPersona,
            'nombre' => $this->request->getPost('nombre')
        ];

        $perfilModel->actualizarPerfil($idUsuario, $dataUsuario, $dataPersona);

        return redirect()->to(base_url('perfil'))->with('msg', 'Perfil actualizado correctamente');
    }
}

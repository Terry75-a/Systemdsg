<!-- ══════════════════════════════════════════════════════════════ -->
<!-- JAVASCRIPT                                                     -->
<!-- ══════════════════════════════════════════════════════════════ -->
<script>
    const BASE_URL = '<?= base_url() ?>';

    // ── GUARDAR NUEVO ──────────────────────────────────────────────
    document.getElementById('formNuevoPermiso').addEventListener('submit', function (e) {
        e.preventDefault();
        const formData = new FormData(this);

        fetch(BASE_URL + 'permisos/guardar', {
            method: 'POST',
            headers: { 'X-Requested-With': 'XMLHttpRequest' },
            body: formData
        })
            .then(r => r.json())
            .then(res => {
                if (res.success) {
                    bootstrap.Modal.getInstance(document.getElementById('modalNuevoPermiso')).hide();
                    location.reload();
                } else {
                    alert(res.message || 'Error al guardar.');
                }
            })
            .catch(() => alert('Error de conexión.'));
    });

    // ── ABRIR MODAL EDITAR ────────────────────────────────────────
    document.querySelectorAll('.btn-editar').forEach(btn => {
        btn.addEventListener('click', function () {
            const id = this.dataset.id;

            fetch(BASE_URL + 'permisos/obtener/' + id, {
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            })
                .then(r => r.json())
                .then(res => {
                    if (!res.success) { alert(res.message); return; }
                    const p = res.permiso;

                    document.getElementById('edit_id_permiso').value = p.id_permiso;
                    document.getElementById('edit_rol_nombre').textContent = p.rol_nombre ?? '—';
                    document.getElementById('edit_menu_nombre').textContent = p.menu_nombre ?? '—';
                    document.getElementById('edit_read').checked = p.read == 1;
                    document.getElementById('edit_insert').checked = p.insert == 1;
                    document.getElementById('edit_update').checked = p.update == 1;
                    document.getElementById('edit_delete').checked = p.delete == 1;

                    new bootstrap.Modal(document.getElementById('modalEditarPermiso')).show();
                })
                .catch(() => alert('Error al cargar el permiso.'));
        });
    });

    // ── GUARDAR EDICIÓN ───────────────────────────────────────────
    document.getElementById('formEditarPermiso').addEventListener('submit', function (e) {
        e.preventDefault();
        const id = document.getElementById('edit_id_permiso').value;
        const formData = new FormData(this);

        fetch(BASE_URL + 'permisos/editar/' + id, {
            method: 'POST',
            headers: { 'X-Requested-With': 'XMLHttpRequest' },
            body: formData
        })
            .then(r => r.json())
            .then(res => {
                if (res.success) {
                    bootstrap.Modal.getInstance(document.getElementById('modalEditarPermiso')).hide();
                    location.reload();
                } else {
                    alert(res.message || 'Error al actualizar.');
                }
            })
            .catch(() => alert('Error de conexión.'));
    });

    // ── ELIMINAR ──────────────────────────────────────────────────
    document.querySelectorAll('.btn-eliminar').forEach(btn => {
        btn.addEventListener('click', function () {
            if (!confirm('¿Eliminar este permiso?')) return;
            const id = this.dataset.id;

            fetch(BASE_URL + 'permisos/eliminar/' + id, {
                method: 'POST',
                headers: {
                    'X-Requested-With': 'XMLHttpRequest',
                    'Content-Type': 'application/x-www-form-urlencoded'
                },
                body: '<?= csrf_token() ?>=' + '<?= csrf_hash() ?>'
            })
                .then(r => r.json())
                .then(res => {
                    if (res.success) {
                        location.reload();
                    } else {
                        alert(res.message || 'Error al eliminar.');
                    }
                })
                .catch(() => alert('Error de conexión.'));
        });
    });
</script>
$departamentos = $departamentos ?? [];

$value = static function (string $key, $personaValue = '', $empresaValue = '') {
    $oldValue = old($key);
    if ($oldValue !== null && trim((string) $oldValue) !== '') {
        return $oldValue;
    }

    if ($personaValue !== '') {
        return $personaValue;
    }

    return $empresaValue;
};

$personaDepartamento = (string) $value('departamento_rep', $persona->id_departamento ?? '');
$personaProvincia = (string) $value('provincia_rep', $persona->id_provincia ?? '');

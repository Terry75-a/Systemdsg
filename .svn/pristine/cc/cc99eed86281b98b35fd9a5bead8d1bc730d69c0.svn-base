<script>
const csrfName = '<?= csrf_token() ?>';
const csrfHash = '<?= csrf_hash() ?>';
const lookupFeedbackPersona = document.getElementById('lookup-feedback-persona');

function announceLookup(message) {
    if (lookupFeedbackPersona) {
        lookupFeedbackPersona.textContent = message;
    }
}

function showAlert(targetId, type, message) {
    const target = document.getElementById(targetId);
    if (!target) return;
    target.innerHTML = `<small class="text-${type}">${message}</small>`;
}

async function lookupDocumento({ inputId, buttonId, spinnerId, iconId, endpoint, payloadKey, onSuccess, onError, alertId, regex, invalidMessage }) {
    const input = document.getElementById(inputId);
    const button = document.getElementById(buttonId);
    const spinner = document.getElementById(spinnerId);
    const icon = document.getElementById(iconId);
    const value = (input?.value ?? '').trim();

    if (!regex.test(value)) {
        showAlert(alertId, 'danger', `<i class="fa-solid fa-triangle-exclamation"></i> ${invalidMessage}`);
        announceLookup(invalidMessage);
        return;
    }

    showAlert(alertId, '', '');
    spinner.classList.remove('d-none');
    icon.classList.add('d-none');
    button.disabled = true;
    announceLookup(`Buscando datos para ${value}.`);

    try {
        const body = new URLSearchParams();
        body.append(payloadKey, value);
        body.append(csrfName, csrfHash);

        const res = await fetch(endpoint, {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: body.toString()
        });

        const data = await res.json();
        if (data.success) {
            onSuccess(data);
            showAlert(alertId, 'success', '<i class="fa-solid fa-circle-check"></i> Datos encontrados correctamente.');
            announceLookup('Datos encontrados correctamente.');
            return;
        }

        onError();
        const msg = data.message ?? 'No encontrado';
        const type = data.registrado ? 'warning' : 'danger';
        showAlert(alertId, type, `<i class="fa-solid fa-circle-xmark"></i> ${msg}`);
        announceLookup(msg);
    } catch (error) {
        console.error(error);
        showAlert(alertId, 'danger', '<i class="fa-solid fa-circle-xmark"></i> Error de conexión. Intenta nuevamente.');
        announceLookup('Error de conexión. Intenta nuevamente.');
    } finally {
        spinner.classList.add('d-none');
        icon.classList.remove('d-none');
        button.disabled = false;
    }
}

function setupUbigeo(deptId, provId, distId, selectedProv, selectedDist) {
    const dept = document.getElementById(deptId);
    const prov = document.getElementById(provId);
    const dist = document.getElementById(distId);

    const reset = (select) => { select.innerHTML = '<option value="">-- Seleccionar --</option>'; };
    const fill = (select, items, selected = '') => {
        reset(select);
        items.forEach((item) => {
            const opt = document.createElement('option');
            opt.value = item.id;
            opt.textContent = item.name;
            if (String(item.id) === String(selected)) opt.selected = true;
            select.appendChild(opt);
        });
    };

    const loadDistricts = async (provinceId, selected = '') => {
        reset(dist);
        if (!provinceId) return;
        const res = await fetch(`<?= base_url('ubigeo/distritos') ?>/${provinceId}`);
        fill(dist, await res.json(), selected);
    };

    const loadProvinces = async (departmentId, selectedProvince = '', selectedDistrict = '') => {
        reset(prov);
        reset(dist);
        if (!departmentId) return;
        const res = await fetch(`<?= base_url('ubigeo/provincias') ?>/${departmentId}`);
        fill(prov, await res.json(), selectedProvince);
        if (selectedProvince) {
            await loadDistricts(selectedProvince, selectedDistrict);
        }
    };

    dept.addEventListener('change', function () { loadProvinces(this.value); });
    prov.addEventListener('change', function () { loadDistricts(this.value); });

    if (dept.value) {
        loadProvinces(dept.value, selectedProv, selectedDist);
    }
}

document.addEventListener('DOMContentLoaded', function () {
    setupUbigeo('departamento_rep', 'provincia_rep', 'distrito_rep', '<?= esc($personaProvincia) ?>', '<?= esc($personaDistrito) ?>');
    setupUbigeo('departamento_repdos', 'provincia_repdos', 'distrito_repdos', '<?= esc($empresaProvincia) ?>', '<?= esc($empresaDistrito) ?>');

    document.getElementById('btnBuscarDni').addEventListener('click', () => lookupDocumento({
        inputId: 'dni',
        buttonId: 'btnBuscarDni',
        spinnerId: 'spinnerDni',
        iconId: 'iconoDni',
        endpoint: '<?= base_url('personas/buscar-dni') ?>',
        payloadKey: 'dni',
        alertId: 'alertaDni',
        regex: /^\d{8}$/,
        invalidMessage: 'El DNI debe tener exactamente 8 dígitos numéricos.',
        onSuccess: (data) => {
            document.getElementById('nombre').value = data.nombres ?? '';
            document.getElementById('apellido_paterno').value = data.apellido_paterno ?? '';
            document.getElementById('apellido_materno').value = data.apellido_materno ?? '';
            document.getElementById('telefono').focus();
        },
        onError: () => {
            document.getElementById('nombre').value = '';
            document.getElementById('apellido_paterno').value = '';
            document.getElementById('apellido_materno').value = '';
        }
    }));

    document.getElementById('dni').addEventListener('keydown', function (e) {
        if (e.key === 'Enter') {
            e.preventDefault();
            document.getElementById('btnBuscarDni').click();
        }
    });

    document.getElementById('btnBuscarRuc').addEventListener('click', () => lookupDocumento({
        inputId: 'ruc',
        buttonId: 'btnBuscarRuc',
        spinnerId: 'spinnerRuc',
        iconId: 'iconoRuc',
        endpoint: '<?= base_url('personas/buscar-ruc') ?>',
        payloadKey: 'ruc',
        alertId: 'alertaRuc',
        regex: /^\d{11}$/,
        invalidMessage: 'El RUC debe tener exactamente 11 dígitos numéricos.',
        onSuccess: (data) => {
            document.getElementById('razon_social').value = data.razon ?? '';
            document.getElementById('direccion').value = data.direccion ?? '';
        },
        onError: () => {
            document.getElementById('razon_social').value = '';
            document.getElementById('direccion').value = '';
        }
    }));

    document.getElementById('ruc').addEventListener('keydown', function (e) {
        if (e.key === 'Enter') {
            e.preventDefault();
            document.getElementById('btnBuscarRuc').click();
        }
    });
});
</script>

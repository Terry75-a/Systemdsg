    public function sitemap(): ResponseInterface
    {
        $pages = [
            [
                'loc' => base_url('/'),
                'changefreq' => 'weekly',
                'priority' => '1.0',
            ],
            [
                'loc' => base_url('servicios'),
                'changefreq' => 'weekly',
                'priority' => '0.9',
            ],
            [
                'loc' => base_url('precio'),
                'changefreq' => 'weekly',
                'priority' => '0.8',
            ],
            [
                'loc' => base_url('dsg'),
                'changefreq' => 'monthly',
                'priority' => '0.7',
            ],
            [
                'loc' => base_url('control-de-inventario'),
                'changefreq' => 'weekly',
                'priority' => '0.8',
            ],
            [
                'loc' => base_url('caja-y-punto-de-venta'),
                'changefreq' => 'weekly',
                'priority' => '0.8',
            ],
            [
                'loc' => base_url('reportes-de-ventas'),
                'changefreq' => 'weekly',
                'priority' => '0.8',
            ],
            [
                'loc' => base_url('software-para-restaurantes'),
                'changefreq' => 'weekly',
                'priority' => '0.8',
            ],
            [
                'loc' => base_url('software-para-boticas-farmacias'),
                'changefreq' => 'weekly',
                'priority' => '0.8',
            ],
            [
                'loc' => base_url('software-para-minimarkets'),
                'changefreq' => 'weekly',
                'priority' => '0.8',
            ],
        ];

        $xml = view('seo/sitemap', [
            'pages' => $pages,
            'lastmod' => date('Y-m-d'),
        ]);

        return $this->response
            ->setHeader('Content-Type', 'application/xml; charset=UTF-8')
            ->setBody($xml);
    }

    // Para probar conexión BD
    public function testDB()
    {
        $db = Database::connect();
        if ($db->connect()) {
            echo "Base de datos conectada correctamente";
        } else {
            echo "Error al conectar a la base de datos";
        }
    }

<?php

namespace App\Models;

use CodeIgniter\Model;

class PersonasAddModel extends Model
{
    protected $table = 'personas';

    protected $allowedFields = [
        'nombre',
        'apellido_paterno',
        'apellido_materno',
        'dni',
        'telefono',
        'correo',
        'direccion',
        'fecha_nacimiento',
        'id_pais',
        'id_departamento',
        'id_provincia',
        'id_tipo_documento',
        'id_distrito',
        'imagen',
        'created_at',
    ];

    public $useTimestamps = false;

    public function existeDni(string $dni): bool
    {
        return $this->where('dni', $dni)->first() !== null;
    }
}

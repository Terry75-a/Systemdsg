<div class="card shadow-sm border-0 w-100 h-100 p-0 m-0">
    <div class="card-body p-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="h4 mb-0">Configuración de Permisos</h2>
            <button class="btn btn-success">
                <i class="fa fa-shield-halved me-2"></i> Nuevo Rol
            </button>
        </div>

        <div class="table-responsive">
            <table class="table table-hover border text-center">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Módulo</th>
                        <th>Ver</th>
                        <th>Crear</th>
                        <th>Editar</th>
                        <th>Eliminar</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    <tr class="align-middle">
                        <td colspan="7" class="text-center py-4 text-muted">
                            <i class="fa-solid fa-lock me-2"></i> Configure los niveles de acceso para cada rol aquí.
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

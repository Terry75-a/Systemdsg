/* ================================================
   NAVBAR COMPONENT STYLES
   ================================================ */

.navbar {
  position: fixed;
  top: 20px;
  left: 20px;
  right: 20px;
  background: #8685854a;
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid var(--border-color);
  border-radius: 45px;
  padding: 10px 30px;
  display: flex;
  align-items: center;
  gap: 30px;
  z-index: 1000;
  box-shadow: 0 8px 32px var(--shadow);
  transition: all 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  width: calc(100% - 40px);
  max-width: 1400px;
  margin: 0 auto;
  justify-content: space-between;
}

/* Navbar when scrolled - compact state */
.navbar.navbar-scrolled {
  left: 60px;
  right: 60px;
  width: calc(100% - 120px);
  max-width: 1200px;
  border-radius: 35px;
  padding: 8px 25px;
  gap: 25px;
  top: 15px;
  box-shadow: 0 12px 40px var(--shadow);
}

.navbar:hover {
  transform: translateY(-2px);
  box-shadow: 0 12px 40px var(--shadow);
}

/* Logo Styles */
.logo {
  display: flex;
  align-items: center;
  gap: 12px;
  font-weight: bold;
  font-size: 16px;
  color: var(--text-color);
  text-decoration: none;
  transition: all 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  transform: translateX(-px);
}

/* Logo adaptations when scrolled */
.navbar.navbar-scrolled .logo {
  gap: 10px;
}

.logo-circle {
  width: 60px;
  height: 60px;
  border: 1px solid var(--text-color);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  transition: all 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

/* Logo circle when scrolled - slightly smaller */
.navbar.navbar-scrolled .logo-circle {
  width: 50px;
  height: 50px;
}

.logo-circle img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  border-radius: 50%;
}

.logo-text {
  font-size: 16px;
  font-weight: 600;
  letter-spacing: 0.5px;
  color: black;
  transition: all 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

/* Logo text when scrolled - slightly smaller */
.navbar.navbar-scrolled .logo-text {
  font-size: 15px;
  letter-spacing: 0.3px;
}

/* Navigation Links */
.nav-links {
  display: flex;
  list-style: none;
  gap: 20px;
  margin: 0;
  padding: 0;
  transition: all 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

/* Nav links when scrolled - tighter spacing */
.navbar.navbar-scrolled .nav-links {
  gap: 15px;
}

.nav-link {
  color: black;
  text-decoration: none;
  font-weight: 500;
  font-size: 14px;
  padding: 8px 16px;
  border-radius: 20px;
  transition: all 0.3s ease;
}

.nav-link:hover {
  background: var(--hover-bg);
  color: var(--text-color);
}

/* Scrolled nav link adjustments */
.navbar.navbar-scrolled .nav-link {
  font-size: 13px;
  padding: 6px 12px;
}

/* Theme Toggle */
.theme-toggle {
  background: transparent;
  border: 1px solid var(--border-color);
  border-radius: 50%;
  width: 44px;
  height: 44px;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
  position: relative;
  overflow: hidden;
  color: #ffffff;
}

.theme-toggle:hover {
  background: var(--hover-bg);
  border-color: var(--text-color);
  transform: translateY(-1px);
}

.theme-toggle:active {
  transform: translateY(0);
}

.theme-icon {
  font-size: 20px;
  transition: all 0.2s ease;
  color: #000000;
}

/* ===========================================================
   📱 NAVBAR RESPONSIVE & FLUID DSG PERU TECHNOLOGY
   =========================================================== */
@media (max-width: 1024px) {
  .navbar {
    top: 10px;
    left: 10px;
    right: 10px;
    width: calc(100% - 20px);
    border-radius: 35px;
    padding: 10px 20px;
    justify-content: space-between;
    gap: 15px;
  }

  .logo-circle {
    width: 50px;
    height: 50px;
  }

  .logo-text {
    font-size: 14px;
  }

  .nav-links {
    gap: 10px;
  }
}

/* --- VERSIÓN CELULAR --- */
@media (max-width: 768px) {
  .navbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    margin: 0;
    width: 100%;
    border-radius: 0;
    padding: 12px 20px;
    justify-content: space-between;
    background: rgba(255, 255, 255, 0.75);
    backdrop-filter: blur(25px);
    border: none;
    box-shadow: 0 3px 18px rgba(0, 0, 0, 0.08);
  }

  :root[data-theme="dark"] .navbar {
    background: rgba(25, 25, 25, 0.85);
  }

  /* Logo */
  .logo-circle {
    width: 45px;
    height: 45px;
  }

  .logo-text {
    font-size: 13px;
    letter-spacing: 0.3px;
  }

  /* Menú hamburguesa (oculta links normales) */
  .nav-links {
    display: none;
  }

  /* Botón hamburguesa */
  .menu-toggle {
    background: transparent;
    border: none;
    outline: none;
    font-size: 24px;
    color: #000;
    cursor: pointer;
  }

  :root[data-theme="dark"] .menu-toggle {
    color: #fff;
  }

  /* Menú desplegable */
  .mobile-menu {
    position: absolute;
    top: 60px;
    left: 0;
    width: 100%;
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(15px);
    border-top: 1px solid rgba(0, 0, 0, 0.1);
    display: none;
    flex-direction: column;
    align-items: center;
    gap: 15px;
    padding: 20px 0;
    animation: slideDown 0.3s ease forwards;
  }

  :root[data-theme="dark"] .mobile-menu {
    background: rgba(25, 25, 25, 0.95);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .mobile-menu.show {
    display: flex;
  }

  .mobile-menu a {
    color: #000;
    text-decoration: none;
    font-size: 16px;
    font-weight: 600;
    transition: 0.3s;
  }

  :root[data-theme="dark"] .mobile-menu a {
    color: #fff;
  }

  .mobile-menu a:hover {
    color: #00c896;
  }

  @keyframes slideDown {
    from {
      opacity: 0;
      transform: translateY(-15px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
}
